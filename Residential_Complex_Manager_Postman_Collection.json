            ],
            "url": "{{base_url}}/admins",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"civility\": \"Mr\",\n  \"first_name\": \"Mike\",\n  \"last_name\": \"Building\",\n  \"email\": \"building.admin@example.com\",\n  \"phone\": \"71123456\",\n  \"role\": \"building_admin\",\n  \"status\": \"active\",\n  \"password\": \"Password123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
