              }
            ],
            "url": "{{base_url}}/complexes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Green Valley Complex\",\n  \"address\": \"Main Road\",\n  \"city\": \"Tripoli\",\n  \"postal_code\": \"1300\",\n  \"campaign_name\": \"Summer Campaign\",\n  \"campaign_start_date\": \"2026-06-01\",\n  \"campaign_end_date\": \"2026-08-31\",\n  \"admin_id\": \"{{complex_admin_id}}\"\n}"
