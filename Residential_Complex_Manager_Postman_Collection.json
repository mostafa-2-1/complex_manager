            "url": "{{base_url}}/buildings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tower A\",\n  \"address\": \"Green Valley Complex\",\n  \"floors\": 12,\n  \"units\": 48,\n  \"complex_id\": \"{{complex_id}}\",\n  \"admin_id\": \"{{building_admin_id}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
